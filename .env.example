DATABASE_ADAPTER=sqlite
SQLITE_DATABASE_PATH=./data/gestao-educacional.sqlite
PORT=3001
HOST=127.0.0.1
# Origem pública do frontend Next.js, que encaminha /api para este backend.
PUBLIC_ORIGIN=http://localhost:3000
# Para usar PostgreSQL explicitamente, defina DATABASE_ADAPTER=postgres e DATABASE_URL.
# DATABASE_URL=postgresql://gestao:troque-a-senha@127.0.0.1:5432/gestao
# Para db:provision, defina temporariamente no ambiente:
# INSTITUTION_CODE=escola-exemplo
# INSTITUTION_NAME=Escola de Exemplo
# ADMIN_USERNAME=administrador
# ADMIN_PASSWORD=<uma senha de 12 a 256 caracteres>
# Para db:provision-super-admin, defina temporariamente no ambiente:
# PLATFORM_ADMIN_USERNAME=administrador-da-plataforma
